[sqlfluff]
dialect = snowflake
# jinja (not dbt) templater: lints without a Snowflake connection
templater = jinja
max_line_length = 120
# Column-alignment style used in the models; keyword/function casing stays enforced
exclude_rules = LT01, LT02, LT05, LT09, ST06, AM04

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:templater:jinja:context]
stale_after_days = 7

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
